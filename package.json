{
  "name": "agentic-development-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Hosted collection of skills, plugins and configs for agentic development",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": "12.3.1"
  },
  "packageManager": "pnpm@12.3.1",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "adm-zip": "^0.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \".claude/hooks/__tests__/*.test.js\" \"scripts/__tests__/*.test.js\"",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude=\"**/__tests__/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \".claude/hooks/__tests__/*.test.js\" \"scripts/__tests__/*.test.js\"",
    "export:plugins": "node scripts/export-plugins.js"
  }
}
