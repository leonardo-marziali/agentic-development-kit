{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Claude Code (agentic-development-kit)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "CLAUDE_VERSION": "stable",
      "JDTLS_VERSION": "latest",
      "MARKSMAN_VERSION": "latest",
      "SONAR_CLI_VERSION": "latest",
      "RUFF_VERSION": "latest",
      "MARKETPLACE_REF": "${localEnv:MARKETPLACE_REF}"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "node",
  "postStartCommand": {
    "claude-attribution": "claude-attribution --from-env",
    "gh-login": "gh-login"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "SonarSource.sonarlint-vscode",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
