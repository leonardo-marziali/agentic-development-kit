{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "agentic-development-kit",
  /*
    The image this repository builds and publishes (images/claude-devcontainer).
    Its metadata label already carries remoteUser `node`, the
    docker-outside-of-docker and GitHub CLI features, the Claude Code VS
    Code extension, and the postStartCommand that runs `claude-attribution`
    and `gh-login`.
  */
  "image": "ghcr.io/leonardo-marziali/claude-devcontainer:latest",
  /*
    Persist the Claude Code login (and settings, plugins, history) across
    container rebuilds. On first use Docker seeds the empty volume with the
    image's ~/.claude, so the baked-in plugins carry over.
  */
  "mounts": ["source=claude-config,target=/home/node/.claude,type=volume"],
  /*
    Repository-scoped secrets: GITHUB_PERSONAL_ACCESS_TOKEN and the
    SonarQube CLI's SONARQUBE_CLI_* variables come from
    the gitignored `.env` at the repo root (copy `.env.example`), not from the
    host environment, so they cannot clash with other projects. The file is
    created empty if missing so the container still starts without it.
  */
  "initializeCommand": "touch .env",
  /*
    Optional LLM Wiki: set LLM_WIKI_HOST_PATH in the host environment (not
    .env, which only reaches the container) to a wiki's root directory and it
    is bind-mounted where the image's `wiki` CLI looks for it. Unset, the
    fallback name makes Docker mount an empty named volume instead, which the
    CLI ignores. Unset it rather than leaving it empty: an empty value skips
    the fallback and Docker rejects the mount (see
    images/claude-devcontainer/README.md#llm-wiki).
  */
  "runArgs": [
    "--pull=always",
    "--env-file",
    "${localWorkspaceFolder}/.env",
    "-v",
    "${localEnv:LLM_WIKI_HOST_PATH:llm-wiki-none}:/home/node/llm-wiki"
  ],
  "containerEnv": {
    "CLAUDE_ATTRIBUTION": "false",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  /*
    Caps the SonarLint extension's language server, a JVM that otherwise
    takes a quarter of the container's RAM as its heap ceiling. The setting
    is machine-scoped, so VS Code ignores it in .vscode/settings.json; set
    here, it lands in the container's machine settings. Its idle working set
    is ~400 MB, hence 1 GB rather than the sonarqube plugin's 768 MB.
  */
  "customizations": {
    "vscode": {
      "settings": {
        "sonarlint.ls.vmargs": "-Xmx1g"
      }
    }
  },
  /*
    pnpm comes from Corepack, at the version pinned in package.json's
   `packageManager`. Plugins are not pnpm workspace members, and Claude Code
    runs them in place from this checkout (the repo is a directory
    marketplace), so install each one's dependencies from its own npm
    lockfile, as Claude Code does when it caches a plugin.
  */
  /*
    No postStartCommand of our own: the image's metadata label already runs
    `gh-login` on every start, which logs gh in from
    GITHUB_PERSONAL_ACCESS_TOKEN (see images/claude-devcontainer).
  */
  "postCreateCommand": "sudo corepack enable && pnpm install && for d in plugins/*/; do [ -f \"$d/package-lock.json\" ] && (cd \"$d\" && npm ci --ignore-scripts); done; true"
}
