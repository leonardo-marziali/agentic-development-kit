{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "agentic-development-kit",
  /*
    The image this repository builds and publishes (images/claude-devcontainer).
    Its metadata label already carries remoteUser `node`, the
    docker-outside-of-docker and GitHub CLI features, and the Claude Code VS
    Code extension.
  */
  "image": "ghcr.io/leonardo-marziali/claude-devcontainer:latest",
  /*
    Persist the Claude Code login (and settings, plugins, history) across
    container rebuilds. On first use Docker seeds the empty volume with the
    image's ~/.claude, so the baked-in plugins carry over.
  */
  "mounts": ["source=claude-config,target=/home/node/.claude,type=volume"],
  /*
    Repository-scoped secrets: GITHUB_PERSONAL_ACCESS_TOKEN,
    SONARQUBE_TOKEN and SONARQUBE_URL come from
    the gitignored `.env` at the repo root (copy `.env.example`), not from the
    host environment, so they cannot clash with other projects. The file is
    created empty if missing so the container still starts without it.
  */
  "initializeCommand": "touch .env",
  "runArgs": ["--pull=always", "--env-file", "${localWorkspaceFolder}/.env"],
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  /*
    pnpm comes from Corepack, at the version pinned in package.json's
   `packageManager`. Plugins are not pnpm workspace members, and Claude Code
    runs them in place from this checkout (the repo is a directory
    marketplace), so install each one's dependencies from its own npm
    lockfile, as Claude Code does when it caches a plugin.
  */
  "postCreateCommand": "sudo corepack enable && pnpm install && for d in plugins/*/; do [ -f \"$d/package-lock.json\" ] && (cd \"$d\" && npm ci --ignore-scripts); done; true"
}
