{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "agentic-development-kit": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "git@agentic-development-kit": true,
    "github@agentic-development-kit": true,
    "github@claude-plugins-official": true,
    "markdown@agentic-development-kit": true,
    "prettier@agentic-development-kit": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/track-touched-hook-code.js\"",
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-plugin-tests.js\"",
            "async": false,
            "timeout": 180
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-plugin-tests.js\"",
            "async": false,
            "timeout": 180
          }
        ]
      }
    ]
  }
}
