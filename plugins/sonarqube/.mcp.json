{
  "sonarqube": {
    "command": "docker",
    "args": [
      "run",
      "--init",
      "--pull=always",
      "-i",
      "--rm",
      "-e",
      "SONARQUBE_TOKEN",
      "-e",
      "SONARQUBE_URL",
      "-e",
      "SONARQUBE_TOOLSETS",
      "docker.io/sonarsource/sonarqube-mcp"
    ],
    "env": {
      "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}",
      "SONARQUBE_URL": "${SONARQUBE_URL}",
      "SONARQUBE_TOOLSETS": "analysis,ide,issues,security-hotspots,quality-gates,rules,duplications,measures,dependency-risks,coverage,agentic-readiness,sources,languages,portfolios"
    }
  }
}
