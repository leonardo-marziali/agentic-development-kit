{
  "name": "sonarqube-plugin-tests",
  "private": true,
  "description": "Runtime dependencies and test tooling for the sonarqube plugin's hooks and local SonarLint CLI. Claude Code installs `dependencies` from package-lock.json when it caches the plugin.",
  "dependencies": {
    "@leonardo-marziali/ad-lfl-kit": "1.9.1",
    "vscode-jsonrpc": "10.0.0"
  },
  "scripts": {
    "test": "node --test \"cli/__tests__/*.test.js\" \"scripts/hooks/__tests__/*.test.js\"",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude=\"**/__tests__/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"cli/__tests__/*.test.js\" \"scripts/hooks/__tests__/*.test.js\""
  }
}
