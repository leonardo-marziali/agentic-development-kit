#!/usr/bin/env sh

protected_branch='main'
current_branch=$(git symbolic-ref HEAD | sed -e 's,.*/\(.*\),\1,')

if [ "$current_branch" = "$protected_branch" ]; then
    echo ""
    echo "🚫 Direct pushes to '$protected_branch' are blocked."
    echo "👉 Please open a Pull Request instead:"
    echo "   https://github.com/leonardo-marziali/agentic-development-kit/compare/$protected_branch...$current_branch"
    echo ""
    exit 1
fi
