# Used by the GitHub MCP server and to log in the `gh` CLI on container start
# (the image's `gh-login`). Either a classic PAT with `repo`, `read:org`
# and `workflow` scopes, or a fine-grained PAT; see README.md#dev-container.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Optional long-lived Claude Code token (generate with `claude setup-token`).
# When set, Claude Code authenticates from it, so there is no need to log in
# inside the container. Leave empty to log in interactively instead.
CLAUDE_CODE_OAUTH_TOKEN=
# SonarQube CLI (`sonar`), used by the sonarqube plugin's `sonar api` skill.
# SONARQUBE_CLI_ORG is needed for SonarQube Cloud only.
SONARQUBE_CLI_SERVER=https://sonarcloud.io
SONARQUBE_CLI_ORG=
SONARQUBE_CLI_TOKEN=
